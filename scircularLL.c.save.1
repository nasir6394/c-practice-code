#include<stdio.h>
#include<stdlib.h>
struct Node{
	int data;
	struct Node* next;
}*head=NULL;
void createList(int);
void traverse();
void insertNode(int data,int pos);
int main(int argc,char*argv[]){
	int option, data,position,n;
	while(1){
		printf("1.CreateList\n");
		printf("2.TraverseList\n");
		printf("3.InsertNode\n");
		printf("10.Exit\n");
		scanf("%d",&option);
		switch(option){
			case 1:
				printf("Enter no of nodes:");
				scanf("%d",&n);
				createList(n);
				break;
			case 2:
				traverse();
				break;
			case 3:
				printf("Enter data\n");
				scanf("%d",&data);
				printf("Enter location\n");
				scanf("%d",&position);
				insertNode(data,position);
				break;
			case 10:
				exit(0);
			default:
				printf("Wrong option\n");
				break;
		}
	}
	return 0;
}
void createList(int n){
	struct Node*temp,*p;
	int data,i;
	for(i=1;i<=n;i++){
		temp=(struct Node*)malloc(sizeof(struct Node));
		temp->next=temp;
		printf("Enter data\n");
		scanf("%d",&temp->data);
		if(head==NULL){
			head=temp;
		}else{
			p=head;
			while(p->next!=head)p=p->next;
			p->next=temp;
			p=p->next;
			p->next=head;
		}
	}
}
void traverse(){
	struct Node* p=head;
	if(p==NULL){
		printf("Empty List\n");
	}else{
		do{
			printf("%d\t",p->data);
			p=p->next;
		}while(p!=head);
		printf("\n");
	}
}
